# DocuMind Configuration
PROJECT_NAME=DocuMind
VERSION=1.0.0
API_V1_STR=/api/v1

# Security
SECRET_KEY=documind-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Connection (PostgreSQL)
# Mặc định kết nối local: postgresql://[user]:[password]@[host]:[port]/[db_name]
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=documind
POSTGRES_PORT=5432

# Hoặc dùng chuỗi kết nối trực tiếp (Ghi đè cài đặt trên nếu có):
# DATABASE_URL_OVERRIDE=postgresql://postgres:postgres@localhost:5432/documind

# AI Microservice URL (Chạy ở cổng 8001)
AI_SERVICE_URL=http://localhost:8001
