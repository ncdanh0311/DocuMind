# DocuMind Configuration
PROJECT_NAME=DocuMind
VERSION=1.0.0
API_V1_STR=/api/v1

# Security
# Generate once: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Connection (PostgreSQL)
# Mặc định kết nối local: postgresql://[user]:[password]@[host]:[port]/[db_name]
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=documind
POSTGRES_PORT=5432

# Hoặc dùng chuỗi kết nối trực tiếp (Ghi đè cài đặt trên nếu có):
# DATABASE_URL_OVERRIDE=postgresql://postgres:postgres@localhost:5432/documind
# Direct Neon connection for Alembic/backup; API uses the pooled URL above.
DATABASE_DIRECT_URL=

# AI Microservice URL (Chạy ở cổng 8001)
AI_SERVICE_URL=http://localhost:8001
AI_ENABLED=false

# Explicit browser origins; JSON array. Never use a wildcard in production.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Phase 2: run python -m backend.worker separately from API.
UPLOAD_DIR=.uploads
STORAGE_BACKEND=local
STORAGE_BUCKET=documind-documents
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_UPLOAD_BYTES=26214400
MAX_USER_STORAGE_BYTES=536870912
MAX_TOTAL_STORAGE_BYTES=2147483648
MAX_ACTIVE_JOBS_PER_USER=2
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
EMAILS_FROM_EMAIL=
EXTRACT_TIMEOUT_SECONDS=15
EXTRACT_MAX_PAGES=200
EXTRACT_MAX_CHARACTERS=1000000
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=30
JOB_MAX_SECONDS=1800
AI_TIMEOUT_SECONDS=180
# AI service reads only offline bundles imported with python -m ai.import_model.
AI_MODEL_ROOT=ai/artifacts
